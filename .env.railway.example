# Template Variables untuk Railway — seps.fazagroup.id
# Copy ke Railway → Variables → Raw Editor
# JANGAN commit file ini dengan nilai secret yang sudah diisi!

DATABASE_URL=
DATABASE_URL_DIRECT=

AUTH_SECRET=
AUTH_URL=https://seps.fazagroup.id
PORT=8080

VITE_DATA_BACKEND=neon
VITE_APP_NAME=SEPS
VITE_APP_ENV=production
NODE_ENV=production

# Opsional — Google OAuth
# VITE_GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# VITE_PUBLIC_APP_URL=https://seps.fazagroup.id

# Midtrans Snap (plan billing) — opsional jika tetap pakai Snap
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# MIDTRANS_IS_PRODUCTION=true
# MIDTRANS_NOTIFICATION_URL=https://seps.fazagroup.id/api/midtrans/notification

# Transfer BCA + OCR (Make.com → webhook)
# PLAN_BCA_BANK_NAME=BCA
# PLAN_BCA_ACCOUNT_NUMBER=
# PLAN_BCA_ACCOUNT_NAME=
# PLAN_BCA_QRIS_HINT=
# PLAN_BCA_WEBHOOK_SECRET=
# GEMINI_API_KEY=
# GEMINI_OCR_MODEL=gemini-2.0-flash
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=SEPS <noreply@fazagroup.id>
# FONNTE_TOKEN=
# PLAN_OPS_TELEGRAM_BOT_TOKEN=
# PLAN_OPS_TELEGRAM_CHAT_ID=

# Make.com HTTP: POST https://seps.fazagroup.id/api/plan-billing/bca-inbound
# Header: x-plan-bca-secret = PLAN_BCA_WEBHOOK_SECRET
