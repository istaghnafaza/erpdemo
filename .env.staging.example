# Template Variables — Railway STAGING (staging.seps.fazagroup.id)
# Copy ke Railway staging service → Variables → Raw Editor
# JANGAN commit dengan secret terisi!

DATABASE_URL=
DATABASE_URL_DIRECT=

AUTH_SECRET=
AUTH_URL=https://staging.seps.fazagroup.id
PORT=8080

VITE_DATA_BACKEND=neon
VITE_APP_NAME=SEPS Staging
VITE_APP_ENV=staging
VITE_PUBLIC_APP_URL=https://staging.seps.fazagroup.id
NODE_ENV=production

# Opsional — Google OAuth (tambah origin staging di Google Console)
# VITE_GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Midtrans Snap (plan billing) — opsional
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# MIDTRANS_IS_PRODUCTION=false
# MIDTRANS_NOTIFICATION_URL=https://staging.seps.fazagroup.id/api/midtrans/notification

# Transfer BCA + OCR
