# --- Neon PostgreSQL (production target) ---
DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_DIRECT=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Optional — for scripts/setup-neon-staging-branch.mjs (Neon Console → API keys + Project ID)
# NEON_API_KEY=
# NEON_PROJECT_ID=
# Optional Neon read replica — laporan & dashboard reads (Fase C)
DATABASE_URL_REPLICA=

# --- Auth (session cookie) ---
AUTH_SECRET=change-me-min-32-chars
# Production staging: https://seps.fazagroup.id
AUTH_URL=http://localhost:8080

# --- Backend selector: mock | supabase (rollback) | neon ---
VITE_DATA_BACKEND=neon

# --- Google OAuth ---
# Google HANYA menerima localhost atau domain publik — BUKAN IP 192.168.x.x
# Dev di PC: cukup localhost di bawah
# iPad/iPhone: pakai register email via WiFi, ATAU ngrok (lihat neon/GOOGLE_OAUTH.md)
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opsional — URL publik Cloudflare Tunnel / ngrok / production (tanpa trailing slash):
#   1. Terminal A: npm run dev
#   2. Terminal B: npm run tunnel
#   3. Salin https://xxxx.trycloudflare.com ke dua variabel ini, lalu restart npm run dev
# VITE_PUBLIC_APP_URL=https://xxxx.trycloudflare.com
# AUTH_URL=https://xxxx.trycloudflare.com

# Google Console → Authorized redirect URIs (contoh dev PC):
#   http://localhost:8081/auth/google/callback
# Google Console → Authorized JavaScript origins:
#   http://localhost:8081

VITE_APP_NAME=SEPS
VITE_APP_ENV=development

# --- Midtrans Snap (plan billing) ---
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# MIDTRANS_IS_PRODUCTION=false
# MIDTRANS_NOTIFICATION_URL=https://seps.fazagroup.id/api/midtrans/notification
# (staging: https://staging.seps.fazagroup.id/api/midtrans/notification)

# PLAN_OPS_TELEGRAM_BOT_TOKEN=
# PLAN_OPS_TELEGRAM_CHAT_ID=

# --- Lupa PIN / OTP (opsional; tanpa ini, kode hanya tercatat di log server saat development) ---
# Opsi A — Resend API (verifikasi domain fazagroup.id di Resend):
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=SEPS <seps@fazagroup.id>
#
# Opsi B — SMTP Hostinger (mailbox seps@fazagroup.id):
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=seps@fazagroup.id
# SMTP_PASS=password-mailbox-anda
# SMTP_FROM=SEPS <seps@fazagroup.id>
#
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+62...
# FONNTE_TOKEN=

# --- Legacy Supabase (rollback only — hapus dari production setelah cutover) ---
# VITE_SUPABASE_URL=your_supabase_project_url
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
